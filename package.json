{
  "name": "classmix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "pnpm licenses:generate && pnpm typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "node scripts/generate-icons.mjs",
    "build:win": "tauri build --no-bundle",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "lint": "eslint .",
    "lint:rust": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "typecheck": "tsc",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "licenses:generate": "node scripts/generate-third-party-licenses.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.80.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.5.438",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
